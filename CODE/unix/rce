#!/usr/bin/env bash
#
# Program RCE Mod 20kd.  The Unix counterpart of rce.bat.
#
# Runs in the current directory, on the input deck it finds there.  See
# rcn for why there is no `set -e`.

set -u

. "$(cd "$(dirname "$0")" && pwd)/_common.sh"

ground=0
if [ "${1:-}" = "--ground" ]; then
    ground=1
    shift
fi

cowan_banner 34 \
'                             Program RCE Mod 20kd' \
'                 Least-squares fitting of atomic energy levels'

# rce --ground puts the calculated ground level of OUTGINE at zero first
# (add_eav --ground).  A warning from it, as for INVECT not 0, is no
# reason to stop; an error is, and RCE is then not run.
if [ $ground = 1 ]; then
    "$cowan_dir/unix/add_eav" --ground || exit $?
fi

cowan_run "$cowan_dir/RCE20KD" "$@"
rc=$?

# The batch file's closing line: keep the first RCEINP of a fitting
# session as RCEINP.HF, the Hartree-Fock starting point.  RCE rewrites
# RCEINP with the fitted parameters on every pass, so without this the
# values the fit started from would be gone after the first one.  Only
# ever written if it is not already there.
if [ ! -e RCEINP.HF ] && [ -e RCEINP ]; then
    cp RCEINP RCEINP.HF
fi

exit $rc
